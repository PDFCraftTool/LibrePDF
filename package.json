{
  "name": "pdfopen-studio",
  "version": "1.0.0",
  "type": "module",
  "description": "The Local-First, AI-Native, All-in-One PDF Powerhouse for Global Users",
  "main": "dist-electron/main/index.js",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc && tsc -p tsconfig.node.json --noEmit",
    "build": "npm run typecheck && vite build && electron-builder",
    "build:unpack": "npm run typecheck && vite build && electron-builder --dir",
    "preview": "vite preview",
    "test": "tsx tests/pdfEngine.test.ts && tsx tests/pythonSidecar.test.ts && tsx tests/bentoStirlingEngine.test.ts && tsx tests/editTextBatch.test.ts",
    "test:engine": "tsx tests/pdfEngine.test.ts",
    "test:sidecar": "tsx tests/pythonSidecar.test.ts",
    "test:bento": "tsx tests/bentoStirlingEngine.test.ts",
    "test:editbatch": "tsx tests/editTextBatch.test.ts"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-dropdown-menu": "^2.1.6",
    "@radix-ui/react-slider": "^1.2.3",
    "@radix-ui/react-tabs": "^1.1.3",
    "@radix-ui/react-tooltip": "^1.1.8",
    "@xyflow/react": "^12.4.4",
    "clsx": "^2.1.1",
    "i18next": "^24.2.2",
    "lucide-react": "^1.16.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.10.38",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-i18next": "^15.4.1",
    "tailwind-merge": "^3.0.2",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^34.3.0",
    "electron-builder": "^25.1.8",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.15",
    "typescript": "^5.8.2",
    "vite": "^6.2.1",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6"
  }
}
